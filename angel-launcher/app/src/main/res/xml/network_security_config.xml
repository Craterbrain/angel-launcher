<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only (api.weather.gov), trusting system CAs only. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
